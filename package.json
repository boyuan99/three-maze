{
  "name": "three-maze",
  "version": "0.3.0",
  "description": "A VR environment designed for animal behavior research.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "node start-dev.js",
    "electron:build": "vite build && electron-builder",
    "postinstall": "node setup/setup-python.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "cross-env": "^7.0.3",
    "pinia": "^3.0.4",
    "serialport": "^13.0.0",
    "three": "^0.169.0",
    "vue": "^3.5.12",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "electron": "^33.0.1",
    "electron-builder": "^25.1.8",
    "typescript": "5.9.3",
    "vite": "^5.4.9",
    "vitest": "3.2.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.example.three-maze",
    "productName": "three-maze",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "asar": false
  }
}
