{
  "name": "three-maze",
  "version": "0.3.0",
  "description": "A VR environment designed for animal behavior research.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "node start-dev.js",
    "electron:build": "vite build && electron-builder",
    "protocol:types": "node scripts/gen-link-types.mjs",
    "postinstall": "node setup/setup-python.js",
    "vocabulary": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/vocabulary/generate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:motion": "vitest run --config test/motion/vitest.config.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/e2e/run.mjs",
    "rig:info": "node scripts/rig-info.cjs",
    "timing:gate": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/timing/gate.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "ajv": "8.20.0",
    "pinia": "^3.0.4",
    "three": "0.169.0",
    "vue": "^3.5.12",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.9",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.example.three-maze",
    "productName": "three-maze",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "asar": false
  }
}
